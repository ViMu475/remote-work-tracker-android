<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+: nothing of this app leaves the device through cloud backup or device-to-device transfer.
  The app stores working times of a real person (GDPR); export and backup are done by the user explicitly
  (CSV, PDF, JSON backup). Android 11 and older are covered by android:allowBackup="false".
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
